{
  "name": "@workspace/debugsy",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@uidotdev/usehooks": "^2.4.1",
    "@workspace/harbuz": "workspace:*",
    "@workspace/shadcn": "workspace:*",
    "react-window": "^2.2.3",
    "react-window-infinite-loader": "^2.0.0",
    "superjson": "^2.2.6"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react18-json-view": "^0.2.9"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react18-json-view": "^0.2.9",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./src/components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./src/hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./src/utils/*": {
      "types": "./src/utils/*.ts",
      "default": "./src/utils/*.ts"
    }
  }
}
