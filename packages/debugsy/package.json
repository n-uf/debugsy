{
  "name": "@n-uf/debugsy",
  "version": "26.11.1",
  "description": "In-process React debugging panel: structured logs, render and dependency tracking, module LEDs, and a virtualised log view.",
  "keywords": [
    "react",
    "debug",
    "debugger",
    "debug-panel",
    "devtools",
    "logging",
    "why-did-you-update",
    "re-render",
    "render-tracking",
    "nextjs"
  ],
  "license": "LicenseRef-PolyForm-Perimeter-1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-uf/debugsy.git",
    "directory": "packages/debugsy"
  },
  "homepage": "https://debugsy.n-uf.com",
  "bugs": {
    "url": "https://github.com/n-uf/debugsy/issues"
  },
  "type": "module",
  "sideEffects": true,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./styles": "./src/styles.css",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/check-dist.mjs",
    "prepack": "pnpm run build",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "release:next-version": "node ./scripts/calendar-version-bump.mjs --dry-run",
    "version:bump": "node ./scripts/calendar-version-bump.mjs --apply"
  },
  "dependencies": {
    "react18-json-view": "^0.2.9",
    "superjson": "^2.2.6"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "happy-dom": "^20.14.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./styles": "./src/styles.css"
  }
}
